{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LongPathFix",
  "version": "2.0.0",
  "identifier": "com.mdanamulhasan.longpathfix",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../../src-ui",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build --prefix ../../src-ui",
    "frontendDist": "../../src-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LongPathFix",
        "width": 1220,
        "height": 780,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/app.png",
      "icons/app.ico"
    ]
  }
}
