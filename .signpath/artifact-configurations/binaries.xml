<?xml version="1.0" encoding="utf-8"?>
<!-- LongPathFix's own executable; the .NET runtime bundled in it is third-party and is not signed by us. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="LongPathFix.exe" />
      <authenticode-sign />
    </pe-file-set>
  </zip-file>
</artifact-configuration>
